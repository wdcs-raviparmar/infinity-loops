{
  "name": "infinity-loops",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build --config vite.config.js",
    "build:preview": "vite build --config vite.config.js --mode preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "mongodb-memory-server": "^10.2.0",
    "vite": "^7.1.0"
  }
}
